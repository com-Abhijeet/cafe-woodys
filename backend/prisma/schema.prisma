generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum StaffRole {
  ADMIN
  WAITER
  KITCHEN
  COUNTER
}

enum ZoneType {
  CAFE
  GAMING
}

enum TableStatus {
  FREE
  OCCUPIED
  RESERVED
}

enum GamingSessionStatus {
  ACTIVE
  CLOSED
}

enum OrderType {
  DINE_IN
  PARCEL
}

enum OrderStatus {
  OPEN
  BILLED
  CANCELLED
}

// Kitchen prep state — deliberately separate from OrderStatus (billing).
// An order can be PREPARING while still OPEN, and billing timing is
// independent of cooking progress. Tracked per-Order (one ticket), not
// per-item — simpler for the kitchen board, revisit only if the client
// specifically needs to see individual dishes within one order finish
// at different times.
enum KitchenStatus {
  PENDING
  PREPARING
  READY
  SERVED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  OTHER
}

enum PurchasePaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
  OTHER
}

enum InventoryUnit {
  KG
  G
  L
  ML
  PCS
}

enum InventoryAdjustmentReason {
  WASTAGE
  DAMAGE
  CORRECTION
  OTHER
}

enum SmsStatus {
  SENT
  FAILED
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

enum DiscountScope {
  ALL         // whole bill (food + gaming)
  CAFE_ONLY   // food/drink total only
  GAMING_ONLY // gaming charge only
  ZONE        // a specific Zone, see DiscountRule.zoneId
}

// ─────────────────────────────────────────────
// Staff & Auth
// ─────────────────────────────────────────────

model Staff {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  role         StaffRole
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders         Order[]
  bills          Bill[]
  inventoryAdjustments InventoryAdjustment[]
  voidedBills    Bill[]   @relation("VoidedBills")
  voidedOrderItems OrderItem[]
  voidedGamingSessions GamingSession[]
  refunds        Refund[]
  loyaltyTransactions LoyaltyTransaction[]
}

// ─────────────────────────────────────────────
// Zones & Tables
// ─────────────────────────────────────────────

model Zone {
  id                    String   @id @default(uuid())
  name                  String
  type                  ZoneType
  defaultHalfHourRate   Int?     // paise per player, 0-30 min slab — gaming zones only
  defaultHourlyRate     Int?     // paise per player, 31-60 min slab — gaming zones only
  defaultMaxPlayers     Int?     // seat capacity, gaming zones only
  gstPercent            Decimal? // total GST % applied to this zone's gaming charge — null means fall back to BusinessProfile.defaultGstPercent. Gaming/amusement services are commonly taxed at a different rate from food in India — confirm the correct rate with the client's accountant, don't assume it matches the food rate.
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  tables Table[]
  discountRules DiscountRule[]
}

model Table {
  id            String      @id @default(uuid())
  zoneId        String
  zone          Zone        @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  name          String
  capacity      Int
  halfHourRate  Int?        // overrides zone.defaultHalfHourRate if set (paise)
  hourlyRate    Int?        // overrides zone.defaultHourlyRate if set (paise)
  maxPlayers    Int?        // overrides zone.defaultMaxPlayers if set — caps concurrent ACTIVE GamingSessions on this table
  status        TableStatus @default(FREE)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  gamingSessions GamingSession[]
  orders         Order[]
  bills          Bill[]

  @@index([zoneId])
  @@index([status])
}

// One row = one PLAYER's individual gaming session at a table — not one
// row per table. Players joining a group at different times each get
// their own row with their own startTime, so each is billed correctly
// for their own elapsed time (slab pricing, see calculateSlotCharge in
// gaming-session.service.mjs). A table can have several ACTIVE
// GamingSessions at once (one per seated player), capped by
// table.maxPlayers / zone.defaultMaxPlayers.
model GamingSession {
  id                   String              @id @default(uuid())
  tableId              String
  table                Table               @relation(fields: [tableId], references: [id], onDelete: Restrict)
  billId               String?
  bill                 Bill?               @relation(fields: [billId], references: [id], onDelete: SetNull)
  reopenedFromBillId   String?             // same purpose as Order.reopenedFromBillId — a voided bill's sessions get unlinked here, marking them correctable regardless of status
  reopenedFromBill     Bill?               @relation("GamingSessionReopenedFrom", fields: [reopenedFromBillId], references: [id], onDelete: SetNull)
  playerLabel          String?             // optional display label ("Player 3") for staff UI only, not used in billing
  halfHourRateSnapshot Int                 // paise, 0-30 min slab rate — snapshotted at session start, never re-read live
  hourlyRateSnapshot   Int                 // paise, 31-60 min slab rate — snapshotted at session start, never re-read live
  maxChargeCap         Int?                // paise, optional per-player cap — snapshotted at session start
  gstPercentSnapshot   Decimal             // Zone.gstPercent (or BusinessProfile.defaultGstPercent fallback) at session start — frozen, same reasoning as the rate snapshots above
  startTime            DateTime            @default(now())
  endTime              DateTime?
  status               GamingSessionStatus @default(ACTIVE)
  voidedAt             DateTime?           // a mistakenly-recorded or wrongly-rated session, voided rather than edited — same reasoning as OrderItem. See Phase 19.
  voidReason           String?
  voidedByStaffId      String?
  voidedByStaff        Staff?              @relation(fields: [voidedByStaffId], references: [id], onDelete: SetNull)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([tableId])
  @@index([status])
}

// ─────────────────────────────────────────────
// Menu, Recipes, Inventory
// ─────────────────────────────────────────────

model MenuItem {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Int      // paise
  gstPercent  Decimal? // total GST % for this item (e.g. 5, 12, 18) — null means fall back to BusinessProfile.defaultGstPercent. Set explicitly for anything that isn't standard-rated (packaged goods, exempt items).
  imageUrl    String?  // Cloudinary URL
  category    String
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  recipeIngredients RecipeIngredient[]
  orderItems        OrderItem[]
}

model InventoryItem {
  id                String        @id @default(uuid())
  name              String
  unit              InventoryUnit
  stockQuantity     Decimal       @default(0) // supports fractional kg/l
  reorderThreshold  Decimal       @default(0)
  costPerUnit       Int           // paise, latest known cost
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  recipeIngredients  RecipeIngredient[]
  purchaseOrderItems PurchaseOrderItem[]
  adjustments        InventoryAdjustment[]

  @@index([stockQuantity])
}

// Manual stock corrections — wastage, breakage, spillage, or a
// stocktake correction. This is separate from order-driven deduction
// and purchase-driven stock-in, and exists specifically so those two
// automatic flows stay clean while still allowing staff to account for
// real-world loss. delta is signed: negative for wastage/loss, positive
// for a stocktake correction that finds more stock than recorded.
model InventoryAdjustment {
  id              String                    @id @default(uuid())
  inventoryItemId String
  inventoryItem   InventoryItem             @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  delta           Decimal                   // signed — negative = loss, positive = correction upward
  reason          InventoryAdjustmentReason
  note            String?
  staffId         String
  staff           Staff                     @relation(fields: [staffId], references: [id], onDelete: Restrict)
  createdAt       DateTime                  @default(now())

  @@index([inventoryItemId])
}

// Join table: which ingredients (and how much) a menu item consumes
model RecipeIngredient {
  id              String        @id @default(uuid())
  menuItemId      String
  menuItem        MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  quantity        Decimal       // amount of inventoryItem.unit consumed per one MenuItem sold
  createdAt       DateTime      @default(now())

  @@unique([menuItemId, inventoryItemId])
  @@index([inventoryItemId])
}

// ─────────────────────────────────────────────
// Purchasing (raw material stock-in)
// ─────────────────────────────────────────────

model Supplier {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
  id            String        @id @default(uuid())
  supplierId    String
  supplier      Supplier      @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseDate  DateTime      @default(now())
  totalCost     Int           // paise, sum of line items
  paymentStatus PaymentStatus @default(UNPAID) // recompute from sum(payments.amount) vs totalCost — same pattern as Bill
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  items    PurchaseOrderItem[]
  payments PurchasePayment[]

  @@index([supplierId])
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  quantity        Decimal
  costPerUnit     Int           // paise, cost at time of this purchase
  createdAt       DateTime      @default(now())

  @@index([inventoryItemId])
}

// ─────────────────────────────────────────────
// Customers (mini CRM)
// ─────────────────────────────────────────────

model Customer {
  id        String   @id @default(uuid())
  name      String
  phone     String   @unique
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders  Order[]
  bills   Bill[]
  smsLogs SmsLog[]
  loyaltyTransactions LoyaltyTransaction[]
}

model SmsLog {
  id         String    @id @default(uuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  phone      String
  message    String
  status     SmsStatus
  sentAt     DateTime  @default(now())

  @@index([customerId])
}

// ─────────────────────────────────────────────
// Orders & Billing
// ─────────────────────────────────────────────

model Order {
  id         String      @id @default(uuid())
  tableId    String?     // null for PARCEL orders — see orderType
  table      Table?      @relation(fields: [tableId], references: [id], onDelete: Restrict)
  orderType  OrderType   @default(DINE_IN)
  dailyOrderNumber Int   // resets to 1 after "Close Day" (Phase 13) — see generation logic below, NOT the same as Bill.invoiceNumber
  customerId String?
  customer   Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  staffId    String
  staff      Staff       @relation(fields: [staffId], references: [id], onDelete: Restrict)
  billId     String?
  bill       Bill?       @relation(fields: [billId], references: [id], onDelete: SetNull)
  reopenedFromBillId String? // set when a bill void unlinks this order — the marker that puts item-void into "correction mode" (kitchenStatus no longer gates it). Kept permanently as a historical trail, not cleared on rebilling. See Phase 19.
  reopenedFromBill   Bill?   @relation("OrderReopenedFrom", fields: [reopenedFromBillId], references: [id], onDelete: SetNull)
  status     OrderStatus @default(OPEN)
  kitchenStatus KitchenStatus @default(PENDING)
  boardClearedAt DateTime? // set by the end-of-day "Close Day" action — hides this order from the live order tracker without touching status/kitchenStatus, which stay as the real historical record
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  items OrderItem[]

  @@index([tableId])
  @@index([status])
  @@index([kitchenStatus])
  @@index([boardClearedAt])
  @@index([orderType])
}

model OrderItem {
  id                String   @id @default(uuid())
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId        String
  menuItem          MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  quantity          Int
  priceSnapshot     Int      // paise, MenuItem.price at time of order — never re-read live price for historical orders
  gstPercentSnapshot Decimal // MenuItem.gstPercent (or BusinessProfile.defaultGstPercent fallback) at time of order — frozen, same reasoning as priceSnapshot
  voidedAt          DateTime? // a mistaken line item, voided rather than deleted — excluded from billing calc and the kitchen board once set. Only allowed while the parent Order's kitchenStatus is still PENDING. See Phase 19.
  voidReason        String?
  voidedByStaffId   String?
  voidedByStaff     Staff?   @relation(fields: [voidedByStaffId], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())

  @@index([orderId])
}

model Bill {
  id              String        @id @default(uuid())
  invoiceNumber   Int           // plain sequential 1, 2, 3... resets to 1 every financial year (see financialYear) — NOT globally unique alone, see @@unique below
  financialYear   String        // e.g. "2025-26" — Indian financial year (1 Apr - 31 Mar), computed in billing.service.mjs at bill creation
  tableId         String?       // null for PARCEL bills — see orderType
  table           Table?        @relation(fields: [tableId], references: [id], onDelete: Restrict)
  orderType       OrderType     @default(DINE_IN) // mirrors the linked Order(s)' type — kept explicit here rather than derived via join, since it's read on nearly every bill list/receipt render
  customerId      String?
  customer        Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  staffId         String
  staff           Staff         @relation(fields: [staffId], references: [id], onDelete: Restrict)
  foodTotal       Int           @default(0) // paise
  gamingTotal     Int           @default(0) // paise
  cgstAmount      Int           @default(0) // paise — half of total GST, per BusinessProfile.cgstPercent
  sgstAmount      Int           @default(0) // paise — half of total GST, per BusinessProfile.sgstPercent
  discountAmount  Int           @default(0) // paise — manual entry or auto-applied from a matching DiscountRule at bill time
  discountReason  String?       // e.g. "Happy Hour Gaming", "Manager discount" — always set when discountAmount > 0, never a bare number with no explanation
  grandTotal      Int           // paise
  paymentStatus   PaymentStatus @default(UNPAID) // recompute in payment.service.mjs whenever a Payment is added — UNPAID (0 paid), PARTIALLY_PAID (0 < paid < grandTotal), PAID (paid >= grandTotal)
  voidedAt        DateTime?     // set when a bill is voided instead of edited — see Phase 12 note on why bills are never edited after issue
  voidReason      String?
  voidedByStaffId String?
  voidedByStaff   Staff?        @relation("VoidedBills", fields: [voidedByStaffId], references: [id], onDelete: SetNull)
  correctionOfBillId String?    @unique // set on a NEW bill that replaces a voided one — links the correction back to what it's fixing. See Phase 19.
  correctionOfBill   Bill?      @relation("BillCorrection", fields: [correctionOfBillId], references: [id], onDelete: SetNull)
  correctedByBill    Bill?      @relation("BillCorrection") // the reverse lookup: "was this voided bill ever corrected, and by which new bill"
  loyaltyDiscountAmount   Int     @default(0) // paise — the discount from a points redemption, kept SEPARATE from discountAmount so a Happy Hour discount and a loyalty redemption can both apply to the same bill and stay individually auditable
  loyaltyPointsRedeemed   Int     @default(0) // how many points were spent on this bill, 0 if none — deducted from the customer's balance immediately at Save Bill, not at payment time (see Phase 25)
  loyaltyRedemptionRuleId String?
  loyaltyRedemptionRule   LoyaltyRedemptionRule? @relation(fields: [loyaltyRedemptionRuleId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  orders         Order[]
  gamingSessions GamingSession[]
  payments       Payment[]
  refunds        Refund[]
  loyaltyTransactions LoyaltyTransaction[]
  reopenedOrders Order[]         @relation("OrderReopenedFrom") // orders that were unlinked from THIS bill when it was voided — the correction trail
  reopenedGamingSessions GamingSession[] @relation("GamingSessionReopenedFrom")

  @@unique([invoiceNumber, financialYear])
  @@index([tableId])
  @@index([paymentStatus])
  @@index([customerId])
  @@index([createdAt])
}

// A bill can be settled with more than one payment — split tender
// (part cash + part UPI) or a partial payment followed by a later
// top-up. Never assume one Payment per Bill.
model Payment {
  id        String        @id @default(uuid())
  billId    String
  bill      Bill          @relation(fields: [billId], references: [id], onDelete: Restrict)
  amount    Int           // paise — this single payment's amount, not the bill total
  method    PaymentMethod
  reference String?       // UPI txn id / card auth code / free note, optional
  paidAt    DateTime      @default(now())
  createdAt DateTime      @default(now())

  @@index([billId])
}

// Money returned to a customer, tracked against the ORIGINAL (voided)
// bill it relates to — used when a corrected bill's total is lower
// than what was actually collected on the bill it replaces. This is
// always an explicit, staff-recorded action, never an automatic
// calculation the system applies on its own. See Phase 19.
model Refund {
  id        String        @id @default(uuid())
  billId    String        // the ORIGINAL (now voided) bill the refund relates to
  bill      Bill          @relation(fields: [billId], references: [id], onDelete: Restrict)
  amount    Int           // paise
  reason    String        // required — e.g. "Wrong item billed, corrected in inv-2526-047"
  method    PaymentMethod
  staffId   String
  staff     Staff         @relation(fields: [staffId], references: [id], onDelete: Restrict)
  createdAt DateTime      @default(now())

  @@index([billId])
}

// Money paid OUT to a supplier, tracked per PurchaseOrder — mirrors the
// Bill/Payment pattern but for the outgoing side. Supports split/partial
// payments to suppliers the same way (e.g. advance now, balance later).
model PurchasePayment {
  id              String                @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  amount          Int                   // paise
  method          PurchasePaymentMethod
  reference       String?               // cheque no. / bank txn ref / free note
  paidAt          DateTime              @default(now())
  createdAt       DateTime              @default(now())

  @@index([purchaseOrderId])
}

// ─────────────────────────────────────────────
// Business settings (Phase 11)
// ─────────────────────────────────────────────

// Singleton — always exactly one row. Fetch via findFirst(), not by a
// known id, so the app doesn't hardcode a specific row's id anywhere.
// Pure business identity — nothing operational lives here anymore.
// Every other setting (tax, payment, order workflow, gaming) has its
// own dedicated model below, split out in Phase 24 specifically so
// each table holds only what its name suggests, not a grab-bag of
// unrelated config.
model BusinessProfile {
  id                String   @id @default(uuid())
  businessName      String
  address           String?
  phone             String?
  email             String?
  gstin             String?  // GSTIN, printed on every bill once set
  fssaiNumber       String?  // food license number, common requirement for Indian food businesses
  logoUrl           String?  // Cloudinary URL
  receiptFooterNote String?  // e.g. "Thank you for visiting Cafe Woody's!"
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// Singleton, fetch via findFirst(). Phase 24.
model TaxSettings {
  id                String  @id @default(uuid())
  defaultGstPercent Decimal @default(5) // fallback total GST % (CGST+SGST combined) used only when a MenuItem or Zone doesn't specify its own rate — NOT the rate for everything. See MenuItem.gstPercent / Zone.gstPercent.
  pricesIncludeTax  Boolean @default(false) // global, not per-item — if true, MenuItem.price/gaming rates are treated as tax-inclusive and GST is extracted from within the price rather than added on top. See Phase 16.
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// Singleton, fetch via findFirst(). Phase 24.
model PaymentSettings {
  id                      String  @id @default(uuid())
  upiId                   String? // e.g. "cafewoodys@okicici" — used to generate amount-embedded UPI QR codes on bills
  upiPayeeName            String? // display name shown in the customer's UPI app during payment
  autoMarkBillsPaidInFull Boolean @default(false) // if true, billing defaults to instantly recording full payment — overridable per bill. See Phase 16.
  alwaysSaveAndPrint      Boolean @default(false) // if true, Save Bill automatically triggers the customer receipt print immediately after commit. See Phase 22.
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

// Singleton, fetch via findFirst(). Phase 24.
model OrderSettings {
  id                             String   @id @default(uuid())
  orderCancellationWindowSeconds Int      @default(300) // how long after submission staff can void a just-placed order before it's treated as final — see Phase 9 Step 7 / Phase 18
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt
}

// Singleton, fetch via findFirst(). Phase 24.
model GamingSettings {
  id                       String   @id @default(uuid())
  gamingGracePeriodMinutes Int      @default(5) // forgiveness window applied at each 30-min slab boundary when closing a gaming session — see Phase 12
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

// ─────────────────────────────────────────────
// Printers (Phase 20) — deliberately separate from BusinessProfile.
// There can be more than one printer (a billing printer and a kitchen
// printer, potentially on different devices/connections entirely), so
// this could never have stayed as flat fields on a singleton anyway.
// ─────────────────────────────────────────────

enum PrinterPurpose {
  BILLING // the customer-facing bill/receipt printer
  KITCHEN // KOT printer — see Phase 20 Step 4
}

enum PrinterConnectionType {
  TCP             // WiFi/LAN, IP:port
  USB             // native USB (Android USB Host, or a PC's OS-driver printer)
  BLUETOOTH
  SYSTEM_DEFAULT  // PC connector (Phase 18) — whatever the OS's own default printer is
}

model PrinterConfig {
  id                    String                @id @default(uuid())
  name                  String                // e.g. "Counter Printer", "Kitchen Printer"
  purpose               PrinterPurpose
  connectionType        PrinterConnectionType @default(TCP)
  ipAddress             String?               // for TCP
  paperWidthMm          Int                   @default(80) // free-form, see Phase 18 Step 2 — same auto-formula/override logic, just scoped per printer now instead of business-wide
  charsPerLineOverride  Int?
  isEnabled             Boolean               @default(true) // e.g. the kitchen printer can be turned off entirely if the café is using the on-screen Order Board instead — see Phase 20 Step 4
  isDefault             Boolean               @default(false) // only one PrinterConfig per purpose should be true — enforced in printer.service.mjs, not a DB constraint (Prisma doesn't support a clean partial-unique index for this)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([purpose])
}

// An automatic discount rule (e.g. "Happy Hour Gaming 5-7pm, 20% off").
// Evaluated at bill-generation time — see billing.service.mjs. A bill's
// actual discountAmount/discountReason (on the Bill model) is still the
// single source of truth for what was applied; this table is the
// configuration that produces a suggested value, not a live link.
model DiscountRule {
  id         String        @id @default(uuid())
  name       String
  type       DiscountType
  value      Int           // percentage (0-100) if type=PERCENTAGE, paise if type=FLAT
  scope      DiscountScope @default(ALL)
  zoneId     String?
  zone       Zone?         @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  daysOfWeek Int[]         // 0=Sunday..6=Saturday, empty = every day
  startTime  String?       // "HH:mm", null = no time restriction
  endTime    String?       // "HH:mm"
  isActive   Boolean       @default(true)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([isActive])
  @@index([zoneId])
}

// Singleton, like BusinessProfile — fetch via findFirst(). Deliberately
// separate from PrinterConfig: PrinterConfig is "which printer, what
// connection"; this is "when should a kitchen-style slip print at
// all." Phase 21.
model KitchenPrintSettings {
  id                  String   @id @default(uuid())
  printOnEveryOrder   Boolean  @default(false) // print immediately when ANY order (dine-in or parcel) is submitted — covers waiters' dine-in orders and single-screen/no-kitchen-display setups
  printWithParcelBill Boolean  @default(false) // additionally print a kitchen-style slip when a parcel bill is generated, independent of printOnEveryOrder
  paperOnlyKitchenTracking Boolean @default(false) // true if the café has no kitchen screen at all and relies purely on printed KOTs — when true, kitchenStatus is still recorded but never gates billing (Phase 17 Step 5's check is skipped entirely, for both dine-in and parcel), since the app has no reliable way to know real kitchen progress without a screen someone actually taps. See Phase 23.
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// ─────────────────────────────────────────────
// Customer Loyalty (Phase 25)
// ─────────────────────────────────────────────

enum LoyaltyTransactionType {
  EARNED   // credited when a bill becomes fully PAID
  REDEEMED // spent at billing time via a LoyaltyRedemptionRule
  REVERSED // a previously EARNED or REDEEMED transaction undone because its bill was voided
  ADJUSTED // manual admin correction (goodwill grant, error fix) — always requires a note
}

// Singleton, fetch via findFirst().
model LoyaltySettings {
  id                         String   @id @default(uuid())
  isEnabled                  Boolean  @default(false) // master switch for the whole feature
  pointsEarnedPerUnit        Int      @default(1)  // e.g. 1 point...
  spendUnitInRupees          Int      @default(10) // ...per every ₹10 spent — avoids fractional "points per rupee" input
  maxRedemptionPercentOfBill Int?     // nullable = no cap; 0-100 if the admin sets one. Strongly recommended to set — otherwise a bill could be reduced to ₹0 via points, a zero-revenue transaction.
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

// The tiered options staff present at billing — "spend N points, get X
// off." Lives conceptually alongside DiscountRule (same section in
// Settings) but is a distinct model: DiscountRule is automatic/
// time-based, this is a menu of choices a customer actively redeems
// against their own points balance.
model LoyaltyRedemptionRule {
  id             String       @id @default(uuid())
  pointsRequired Int          // e.g. 100
  discountType   DiscountType // reuse existing enum: PERCENTAGE | FLAT
  discountValue  Int          // percentage (0-100) or paise, per discountType — same pattern as DiscountRule.value
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  bills Bill[]

  @@index([isActive])
}

// The full earn/spend ledger — this is the "points table" on the
// customer profile. Balance is ALWAYS computed by summing
// pointsDelta for a customer, never cached on Customer — same
// principle as the Customer Ledger (Phase 10), which sums Bills/
// Payments rather than storing a running total that could drift.
model LoyaltyTransaction {
  id         String                 @id @default(uuid())
  customerId String
  customer   Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  billId     String?                // the bill that caused this — nullable for manual ADJUSTED entries
  bill       Bill?                  @relation(fields: [billId], references: [id], onDelete: SetNull)
  type       LoyaltyTransactionType
  pointsDelta Int                   // positive for EARNED / a goodwill ADJUSTED credit; negative for REDEEMED / REVERSED-of-an-earn / an ADJUSTED debit
  note       String?                // required for ADJUSTED, optional context otherwise (e.g. "Reversed — bill voided")
  staffId    String?                // who triggered it — null for automatic EARNED/REVERSED, set for a manual ADJUSTED entry or the staff who processed a REDEEMED action at billing
  staff      Staff?                 @relation(fields: [staffId], references: [id], onDelete: SetNull)
  createdAt  DateTime               @default(now())

  @@index([customerId])
  @@index([billId])
}
