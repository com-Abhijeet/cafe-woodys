// Cafe Woody's — Prisma schema
// Place at: backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum StaffRole {
  ADMIN
  WAITER
  KITCHEN
  COUNTER
}

enum ZoneType {
  CAFE
  GAMING
}

enum TableStatus {
  FREE
  OCCUPIED
  RESERVED
}

enum GamingSessionStatus {
  ACTIVE
  CLOSED
}

enum OrderType {
  DINE_IN
  PARCEL
}

enum OrderStatus {
  OPEN
  BILLED
  CANCELLED
}

// Kitchen prep state — deliberately separate from OrderStatus (billing).
// An order can be PREPARING while still OPEN, and billing timing is
// independent of cooking progress. Tracked per-Order (one ticket), not
// per-item — simpler for the kitchen board, revisit only if the client
// specifically needs to see individual dishes within one order finish
// at different times.
enum KitchenStatus {
  PENDING
  PREPARING
  READY
  SERVED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  OTHER
}

enum PurchasePaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
  OTHER
}

enum InventoryUnit {
  KG
  G
  L
  ML
  PCS
}

enum InventoryAdjustmentReason {
  WASTAGE
  DAMAGE
  CORRECTION
  OTHER
}

enum SmsStatus {
  SENT
  FAILED
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

enum DiscountScope {
  ALL         // whole bill (food + gaming)
  CAFE_ONLY   // food/drink total only
  GAMING_ONLY // gaming charge only
  ZONE        // a specific Zone, see DiscountRule.zoneId
}

// ─────────────────────────────────────────────
// Staff & Auth
// ─────────────────────────────────────────────

model Staff {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  role         StaffRole
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders               Order[]
  bills                Bill[]
  inventoryAdjustments InventoryAdjustment[]
  voidedBills          Bill[]   @relation("VoidedBills")
  voidedOrderItems     OrderItem[]
  refunds              Refund[]
}

// ─────────────────────────────────────────────
// Zones & Tables
// ─────────────────────────────────────────────

model Zone {
  id                  String   @id @default(uuid())
  name                String
  type                ZoneType
  defaultHalfHourRate Int?     // paise per player, 0-30 min slab — gaming zones only
  defaultHourlyRate   Int?     // paise per player, 31-60 min slab — gaming zones only
  defaultMaxPlayers   Int?     // seat capacity, gaming zones only
  gstPercent          Decimal? // total GST % applied to this zone's gaming charge — null means fall back to BusinessProfile.defaultGstPercent. Gaming/amusement services are commonly taxed at a different rate from food in India — confirm the correct rate with the client's accountant, don't assume it matches the food rate.
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tables        Table[]
  discountRules DiscountRule[]
}

model Table {
  id           String      @id @default(uuid())
  zoneId       String
  zone         Zone        @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  name         String
  capacity     Int
  halfHourRate Int?        // overrides zone.defaultHalfHourRate if set (paise)
  hourlyRate   Int?        // overrides zone.defaultHourlyRate if set (paise)
  maxPlayers   Int?        // overrides zone.defaultMaxPlayers if set — caps concurrent ACTIVE GamingSessions on this table
  status       TableStatus @default(FREE)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  gamingSessions GamingSession[]
  orders         Order[]
  bills          Bill[]

  @@index([zoneId])
  @@index([status])
}

// One row = one PLAYER's individual gaming session at a table — not one
// row per table. Players joining a group at different times each get
// their own row with their own startTime, so each is billed correctly
// for their own elapsed time (slab pricing, see calculateSlotCharge in
// gaming-session.service.mjs). A table can have several ACTIVE
// GamingSessions at once (one per seated player), capped by
// table.maxPlayers / zone.defaultMaxPlayers.
model GamingSession {
  id                   String              @id @default(uuid())
  tableId              String
  table                Table               @relation(fields: [tableId], references: [id], onDelete: Restrict)
  billId               String?
  bill                 Bill?               @relation(fields: [billId], references: [id], onDelete: SetNull)
  playerLabel          String?             // optional display label ("Player 3") for staff UI only, not used in billing
  halfHourRateSnapshot Int                 // paise, 0-30 min slab rate — snapshotted at session start, never re-read live
  hourlyRateSnapshot   Int                 // paise, 31-60 min slab rate — snapshotted at session start, never re-read live
  maxChargeCap         Int?                // paise, optional per-player cap — snapshotted at session start
  gstPercentSnapshot   Decimal             // Zone.gstPercent (or BusinessProfile.defaultGstPercent fallback) at session start — frozen, same reasoning as the rate snapshots above
  startTime            DateTime            @default(now())
  endTime              DateTime?
  status               GamingSessionStatus @default(ACTIVE)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([tableId])
  @@index([status])
}

// ─────────────────────────────────────────────
// Menu, Recipes, Inventory
// ─────────────────────────────────────────────

model MenuItem {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Int      // paise
  gstPercent  Decimal? // total GST % for this item (e.g. 5, 12, 18) — null means fall back to BusinessProfile.defaultGstPercent. Set explicitly for anything that isn't standard-rated (packaged goods, exempt items).
  imageUrl    String?  // Cloudinary URL
  category    String
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  recipeIngredients RecipeIngredient[]
  orderItems        OrderItem[]
}

model InventoryItem {
  id               String        @id @default(uuid())
  name             String
  unit             InventoryUnit
  stockQuantity    Decimal       @default(0) // supports fractional kg/l
  reorderThreshold Decimal       @default(0)
  costPerUnit      Int           // paise, latest known cost
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  recipeIngredients  RecipeIngredient[]
  purchaseOrderItems PurchaseOrderItem[]
  adjustments        InventoryAdjustment[]

  @@index([stockQuantity])
}

// Manual stock corrections — wastage, breakage, spillage, or a
// stocktake correction. This is separate from order-driven deduction
// and purchase-driven stock-in, and exists specifically so those two
// automatic flows stay clean while still allowing staff to account for
// real-world loss. delta is signed: negative for wastage/loss, positive
// for a stocktake correction that finds more stock than recorded.
model InventoryAdjustment {
  id              String                    @id @default(uuid())
  inventoryItemId String
  inventoryItem   InventoryItem             @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  delta           Decimal                   // signed — negative = loss, positive = correction upward
  reason          InventoryAdjustmentReason
  note            String?
  staffId         String
  staff           Staff                     @relation(fields: [staffId], references: [id], onDelete: Restrict)
  createdAt       DateTime                  @default(now())

  @@index([inventoryItemId])
}

// Join table: which ingredients (and how much) a menu item consumes
model RecipeIngredient {
  id              String        @id @default(uuid())
  menuItemId      String
  menuItem        MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  quantity        Decimal       // amount of inventoryItem.unit consumed per one MenuItem sold
  createdAt       DateTime      @default(now())

  @@unique([menuItemId, inventoryItemId])
  @@index([inventoryItemId])
}

// ─────────────────────────────────────────────
// Purchasing (raw material stock-in)
// ─────────────────────────────────────────────

model Supplier {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
  id            String        @id @default(uuid())
  supplierId    String
  supplier      Supplier      @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseDate  DateTime      @default(now())
  totalCost     Int           // paise, sum of line items
  paymentStatus PaymentStatus @default(UNPAID) // recompute from sum(payments.amount) vs totalCost — same pattern as Bill
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  items    PurchaseOrderItem[]
  payments PurchasePayment[]

  @@index([supplierId])
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  quantity        Decimal
  costPerUnit     Int           // paise, cost at time of this purchase
  createdAt       DateTime      @default(now())

  @@index([inventoryItemId])
}

// ─────────────────────────────────────────────
// Customers (mini CRM)
// ─────────────────────────────────────────────

model Customer {
  id        String   @id @default(uuid())
  name      String
  phone     String   @unique
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders  Order[]
  bills   Bill[]
  smsLogs SmsLog[]
}

model SmsLog {
  id         String    @id @default(uuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  phone      String
  message    String
  status     SmsStatus
  sentAt     DateTime  @default(now())

  @@index([customerId])
}

// ─────────────────────────────────────────────
// Orders & Billing
// ─────────────────────────────────────────────

model Order {
  id               String        @id @default(uuid())
  tableId          String?       // null for PARCEL orders — see orderType
  table            Table?        @relation(fields: [tableId], references: [id], onDelete: Restrict)
  orderType        OrderType     @default(DINE_IN)
  dailyOrderNumber Int           @default(1) // resets to 1 after "Close Day" (Phase 13) — see generation logic below, NOT the same as Bill.invoiceNumber
  customerId       String?
  customer         Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  staffId          String
  staff            Staff         @relation(fields: [staffId], references: [id], onDelete: Restrict)
  billId           String?
  bill             Bill?         @relation(fields: [billId], references: [id], onDelete: SetNull)
  status           OrderStatus   @default(OPEN)
  kitchenStatus    KitchenStatus @default(PENDING)
  boardClearedAt   DateTime?     // set by the end-of-day "Close Day" action — hides this order from the live order tracker without touching status/kitchenStatus, which stay as the real historical record
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  items OrderItem[]

  @@index([tableId])
  @@index([status])
  @@index([kitchenStatus])
  @@index([boardClearedAt])
  @@index([orderType])
}

model OrderItem {
  id                 String    @id @default(uuid())
  orderId            String
  order              Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId         String
  menuItem           MenuItem  @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  quantity           Int
  priceSnapshot      Int       // paise, MenuItem.price at time of order — never re-read live price for historical orders
  gstPercentSnapshot Decimal   // MenuItem.gstPercent (or BusinessProfile.defaultGstPercent fallback) at time of order — frozen, same reasoning as priceSnapshot
  voidedAt           DateTime? // a mistaken line item, voided rather than deleted — excluded from billing calc and the kitchen board once set. Only allowed while the parent Order's kitchenStatus is still PENDING. See Phase 19.
  voidReason         String?
  voidedByStaffId    String?
  voidedByStaff      Staff?    @relation(fields: [voidedByStaffId], references: [id], onDelete: SetNull)
  createdAt          DateTime  @default(now())

  @@index([orderId])
}

model Bill {
  id                 String        @id @default(uuid())
  invoiceNumber      Int           // plain sequential 1, 2, 3... resets to 1 every financial year (see financialYear) — NOT globally unique alone, see @@unique below
  financialYear      String        // e.g. "2025-26" — Indian financial year (1 Apr - 31 Mar), computed in billing.service.mjs at bill creation
  tableId            String?       // null for PARCEL bills — see orderType
  table              Table?        @relation(fields: [tableId], references: [id], onDelete: Restrict)
  orderType          OrderType     @default(DINE_IN) // mirrors the linked Order(s)' type — kept explicit here rather than derived via join, since it's read on nearly every bill list/receipt render
  customerId         String?
  customer           Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  staffId            String
  staff              Staff         @relation(fields: [staffId], references: [id], onDelete: Restrict)
  foodTotal          Int           @default(0) // paise
  gamingTotal        Int           @default(0) // paise
  cgstAmount         Int           @default(0) // paise — half of total GST, per BusinessProfile.cgstPercent
  sgstAmount         Int           @default(0) // paise — half of total GST, per BusinessProfile.sgstPercent
  discountAmount     Int           @default(0) // paise — manual entry or auto-applied from a matching DiscountRule at bill time
  discountReason     String?       // e.g. "Happy Hour Gaming", "Manager discount" — always set when discountAmount > 0, never a bare number with no explanation
  grandTotal         Int           // paise
  paymentStatus      PaymentStatus @default(UNPAID) // recompute in payment.service.mjs whenever a Payment is added — UNPAID (0 paid), PARTIALLY_PAID (0 < paid < grandTotal), PAID (paid >= grandTotal)
  voidedAt           DateTime?     // set when a bill is voided instead of edited — see Phase 12 note on why bills are never edited after issue
  voidReason         String?
  voidedByStaffId    String?
  voidedByStaff      Staff?        @relation("VoidedBills", fields: [voidedByStaffId], references: [id], onDelete: SetNull)
  correctionOfBillId String?       @unique // set on a NEW bill that replaces a voided one — links the correction back to what it's fixing. See Phase 19.
  correctionOfBill   Bill?         @relation("BillCorrection", fields: [correctionOfBillId], references: [id], onDelete: SetNull)
  correctedByBill    Bill?         @relation("BillCorrection") // the reverse lookup: "was this voided bill ever corrected, and by which new bill"
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  orders         Order[]
  gamingSessions GamingSession[]
  payments       Payment[]
  refunds        Refund[]

  @@unique([invoiceNumber, financialYear])
  @@index([tableId])
  @@index([paymentStatus])
  @@index([customerId])
  @@index([createdAt])
}

// A bill can be settled with more than one payment — split tender
// (part cash + part UPI) or a partial payment followed by a later
// top-up. Never assume one Payment per Bill.
model Payment {
  id        String        @id @default(uuid())
  billId    String
  bill      Bill          @relation(fields: [billId], references: [id], onDelete: Restrict)
  amount    Int           // paise — this single payment's amount, not the bill total
  method    PaymentMethod
  reference String?       // UPI txn id / card auth code / free note, optional
  paidAt    DateTime      @default(now())
  createdAt DateTime      @default(now())

  @@index([billId])
}

// Money returned to a customer, tracked against the ORIGINAL (voided)
// bill it relates to — used when a corrected bill's total is lower
// than what was actually collected on the bill it replaces. This is
// always an explicit, staff-recorded action, never an automatic
// calculation the system applies on its own. See Phase 19.
model Refund {
  id        String        @id @default(uuid())
  billId    String        // the ORIGINAL (now voided) bill the refund relates to
  bill      Bill          @relation(fields: [billId], references: [id], onDelete: Restrict)
  amount    Int           // paise
  reason    String        // required — e.g. "Wrong item billed, corrected in inv-2526-047"
  method    PaymentMethod
  staffId   String
  staff     Staff         @relation(fields: [staffId], references: [id], onDelete: Restrict)
  createdAt DateTime      @default(now())

  @@index([billId])
}

// Money paid OUT to a supplier, tracked per PurchaseOrder — mirrors the
// Bill/Payment pattern but for the outgoing side. Supports split/partial
// payments to suppliers the same way (e.g. advance now, balance later).
model PurchasePayment {
  id              String                @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  amount          Int                   // paise
  method          PurchasePaymentMethod
  reference       String?               // cheque no. / bank txn ref / free note
  paidAt          DateTime              @default(now())
  createdAt       DateTime              @default(now())

  @@index([purchaseOrderId])
}

// ─────────────────────────────────────────────
// Business settings (Phase 11)
// ─────────────────────────────────────────────

// Singleton — always exactly one row. Fetch via findFirst(), not by a
// known id, so the app doesn't hardcode a specific row's id anywhere.
model BusinessProfile {
  id                             String   @id @default(uuid())
  businessName                   String
  address                        String?
  phone                          String?
  email                          String?
  gstin                          String?  // GSTIN, printed on every bill once set
  fssaiNumber                    String?  // food license number, common requirement for Indian food businesses
  logoUrl                        String?  // Cloudinary URL
  receiptFooterNote              String?  // e.g. "Thank you for visiting Cafe Woody's!"
  defaultGstPercent              Decimal  @default(5) // fallback total GST % (CGST+SGST combined) used only when a MenuItem or Zone doesn't specify its own rate — NOT the rate for everything. See MenuItem.gstPercent / Zone.gstPercent.
  gamingGracePeriodMinutes       Int      @default(5) // forgiveness window applied at each 30-min slab boundary when closing a gaming session — see Phase 12
  orderCancellationWindowSeconds Int      @default(300) // how long after submission staff can void a just-placed order before it's treated as final — see Phase 9 Step 7 / Phase 18
  printerIpAddress               String?  // WiFi thermal printer's local IP, e.g. "192.168.1.123" — set from the counter app's Settings screen, read by the native print plugin. Phase 14.
  pricesIncludeTax               Boolean  @default(false) // global, not per-item — if true, MenuItem.price/gaming rates are treated as tax-inclusive and GST is extracted from within the price rather than added on top. See Phase 16.
  thermalPaperWidthMm            Int      @default(80) // free-form roll width in mm, not a fixed preset — any value the client's printer actually uses. See Phase 18.
  thermalCharsPerLineOverride    Int?     // manual override for character-width-per-line if the auto formula (~0.6 chars/mm) doesn't match the printer's actual font/spacing — null means use the auto formula
  upiId                          String?  // e.g. "cafewoodys@okicici" — used to generate amount-embedded UPI QR codes on bills
  upiPayeeName                   String?  // display name shown in the customer's UPI app during payment
  autoMarkBillsPaidInFull        Boolean  @default(false) // if true, billing defaults to instantly recording full payment — overridable per bill. See Phase 16.
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt
}

// An automatic discount rule (e.g. "Happy Hour Gaming 5-7pm, 20% off").
// Evaluated at bill-generation time — see billing.service.mjs. A bill's
// actual discountAmount/discountReason (on the Bill model) is still the
// single source of truth for what was applied; this table is the
// configuration that produces a suggested value, not a live link.
model DiscountRule {
  id         String        @id @default(uuid())
  name       String
  type       DiscountType
  value      Int           // percentage (0-100) if type=PERCENTAGE, paise if type=FLAT
  scope      DiscountScope @default(ALL)
  zoneId     String?
  zone       Zone?         @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  daysOfWeek Int[]         // 0=Sunday..6=Saturday, empty = every day
  startTime  String?       // "HH:mm", null = no time restriction
  endTime    String?       // "HH:mm"
  isActive   Boolean       @default(true)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([isActive])
  @@index([zoneId])
}
